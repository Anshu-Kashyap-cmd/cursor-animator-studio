{
  "name": "Cursor Animator Studio",
  "short_name": "Cursor Studio",
  "description": "Professional pixel-art workstation for drawing, previewing, and packaging animated and static mouse cursors (.ani/.cur).",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#E8793A",
  "dir": "ltr",
  "lang": "en-US",
  "categories": ["utilities", "productivity", "graphics"],
  "icons": [
    {
      "src": "/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/desktop_screenshot.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Cursor Animator Studio Workspace View"
    },
    {
      "src": "/mobile_screenshot.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Cursor Animator Studio Mobile Preview"
    }
  ],
  "shortcuts": [
    {
      "name": "Create New Cursor",
      "short_name": "New Cursor",
      "description": "Open the workspace to design a new custom cursor from scratch",
      "url": "/?action=new-cursor",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Dashboard",
      "short_name": "Dashboard",
      "description": "View your saved mouse cursors and active animation projects",
      "url": "/?action=dashboard",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "image/x-win-bitmap": [".cur"],
        "application/octet-stream": [".ani"]
      },
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "display_override": [
    "window-controls-overlay",
    "minimal-ui",
    "standalone"
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/?action=new-cursor"
  },
  "protocol_handlers": [
    {
      "protocol": "web+cursor",
      "url": "/?url=%s"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": []
}
