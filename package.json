{
  "name": "cursor-animator-studio",
  "version": "1.0.0",
  "description": "Professional Windows Animated Cursor (.ANI) and Static Cursor (.CUR) creator, video-to-cursor extractor, and timeline editor by Anshu Kashyap (aicreation2026.blogspot.com).",
  "author": "Anshu Kashyap <aicreation2026.blogspot.com>",
  "homepage": "https://aicreation2026.blogspot.com",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "gifshot": "^0.4.5",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "nanoid": ">=3.3.8",
    "browserslist": ">=4.24.4",
    "baseline-browser-mapping": ">=2.9.0",
    "qs": ">=6.14.0",
    "postcss": ">=8.5.3",
    "@grpc/grpc-js": ">=1.13.0"
  }
